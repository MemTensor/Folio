{
  "name": "folio-markdown",
  "productName": "Folio",
  "version": "0.5.0-beta.14",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/MemTensor/Folio.git"
  },
  "type": "module",
  "description": "A quiet Markdown editor for people and their coding agents.",
  "author": "Folio contributors",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/dev.mjs",
    "start": "electron .",
    "build": "tsc -b && vite build && node scripts/build-cli.mjs && node scripts/build-updater.mjs && node scripts/collect-licenses.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run format:check && npm run test && npm run build && node scripts/verify-cli.mjs && node scripts/verify-desktop.mjs --scenario all --language en && node scripts/verify-heading.mjs && node scripts/verify-updater.mjs && node scripts/verify-shutdown.mjs",
    "pack": "npm run build && electron-builder --mac dir && node scripts/verify-package.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "dist": "npm run build && electron-builder --mac zip && node scripts/verify-package.mjs",
    "cli": "node cli/main.cjs",
    "format": "prettier --write src core electron cli scripts tests vite.config.ts tsconfig.json",
    "format:check": "prettier --check src core electron cli scripts tests vite.config.ts tsconfig.json",
    "release:prepare": "node scripts/publish-release.mjs --prepare",
    "release:publish": "node scripts/publish-release.mjs --publish",
    "verify:desktop": "node scripts/verify-desktop.mjs"
  },
  "dependencies": {
    "@mathjax/mathjax-mhchem-font-extension": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "@resvg/resvg-wasm": "2.6.2",
    "chokidar": "^4.0.3",
    "diff": "^8.0.2",
    "image-size": "2.0.4",
    "markdown-it": "^14.1.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/language-data": "^6.5.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@lezer/highlight": "^1.2.1",
    "@phosphor-icons/react": "^2.1.10",
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dompurify": "^3.2.6",
    "electron": "44.3.0",
    "electron-builder": "^26.0.12",
    "esbuild": "0.28.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.10.0",
    "prettier": "3.9.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  },
  "build": {
    "electronFuses": {
      "runAsNode": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "appId": "io.folio.markdown",
    "productName": "Folio",
    "directories": {
      "output": "release/v0.5.0-beta.14"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "core/**/*",
      "examples/**/*",
      "package.json",
      "README.md",
      "THIRD_PARTY_NOTICES.md",
      "third-party-licenses/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir",
        "zip"
      ],
      "identity": null,
      "icon": "build/icon.icns"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "txt"
        ],
        "name": "Markdown document",
        "role": "Editor"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "extraResources": [
      {
        "from": "dist-cli",
        "to": "cli",
        "filter": [
          "*.cjs",
          "*.wasm"
        ]
      },
      {
        "from": "scripts/folio-bundled.sh",
        "to": "bin/folio"
      },
      {
        "from": "integrations",
        "to": "integrations"
      },
      {
        "from": "dist-updater",
        "to": "updater",
        "filter": [
          "folio-update-helper",
          "build-info.json"
        ]
      }
    ]
  }
}
